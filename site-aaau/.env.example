# Public data and admin write operations
DATABASE_URL="postgresql://usuario:senha@localhost:5432/aaau_site?schema=public"
# Optional direct (non-pooler) PostgreSQL URL used only by migration commands.
DIRECT_URL="postgresql://usuario:senha@localhost:5432/aaau_site?schema=public"

# Admin authentication
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_PASSWORD="troque-esta-senha"
JWT_SECRET="change-this-to-a-long-random-secret-with-32-plus-chars"

# Trusted canonical origin. APP_URL is server-only; keep the public URL equal to it.
APP_URL="https://staging.example.com"
NEXT_PUBLIC_SITE_URL="https://aaau-uniritter.vercel.app"
NEXT_PUBLIC_CLARITY_PROJECT_ID=""

# Mercado Pago checkout
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""

# Transactional email (Resend is preferred in production)
RESEND_API_KEY=""
RESEND_FROM="AAAU UniRitter <ingressos@aaau.com.br>"
RESEND_REPLY_TO=""
RESEND_WEBHOOK_SECRET=""
ORDER_NOTIFICATION_EMAIL=""

# Legacy SMTP fallback (used only when RESEND_API_KEY is empty)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Optional event reservation duration (minutes)
EVENT_TICKET_RESERVATION_MINUTES="15"

# Event ticket transfers (phase 1 remains disabled by default)
EVENT_TICKET_TRANSFERS_ENABLED="false"
EVENT_TICKET_TRANSFER_TOKEN_SECRET="replace-transfer-token-secret-with-32-plus-random-chars"
EVENT_TICKET_TRANSFER_OUTBOX_SECRET="replace-transfer-outbox-secret-with-32-plus-random-chars"
EVENT_TICKET_TRANSFER_BACKFILL_CONFIRM=""
EVENT_TICKET_TRANSFER_BACKFILL_TARGET=""

# Public ticket portal (phase 4 remains disabled by default)
EVENT_TICKET_PORTAL_ENABLED="false"
EVENT_TICKET_PORTAL_SECRET="replace-portal-session-secret-with-32-plus-random-chars"

# Dedicated Vercel Cron authentication; never reuse any token or encryption secret.
CRON_SECRET="replace-outbox-cron-secret-with-32-plus-random-chars"

# Staging-only fixture guard. Never configure these in Production.
ALLOW_STAGING_EVENT_FIXTURE="false"
STAGING_EVENT_STAFF_PASSWORD=""

# Preview-only bypass used by Mercado Pago callbacks when Vercel Deployment Protection is enabled.
VERCEL_AUTOMATION_BYPASS_SECRET=""

# Dedicated integration database. Never point these variables at staging or production.
TEST_DATABASE_URL="postgresql://aaau_test@127.0.0.1:55439/aaau_transfer_test?schema=public"
TEST_DATABASE_DIRECT_URL="postgresql://aaau_test@127.0.0.1:55439/aaau_transfer_test?schema=public"
